{
  email admin@homecarepro.com.br
  on_demand_tls {
    ask http://homecarepro-web:3000/api/internal/caddy-ask
    interval 2m
    burst 5
  }
}

# Wildcard HTTPS for tenant subdomains: <subdomain>.homecare.wootech.com.br
https://*.homecare.wootech.com.br {
  tls {
    on_demand
  }

  reverse_proxy homecarepro-web:3000
  encode gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

# Custom domains via On-Demand TLS (e.g., audcare.com.br, app.audcare.com.br)
https:// {
  tls {
    on_demand
  }

  reverse_proxy homecarepro-web:3000
  encode gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
