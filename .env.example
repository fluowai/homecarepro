# ===== Supabase (Required) =====
# Create a project at https://supabase.com and paste your credentials here.
# Then run the migration: node run-sql.js
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_DB_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# ===== Gemini AI (Optional - falls back to rule-based responses) =====
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ===== Asaas Billing (Optional) =====
ASAAS_API_KEY="YOUR_ASAAS_API_KEY"
ASAAS_WEBHOOK_TOKEN="YOUR_ASAAS_WEBHOOK_TOKEN"

# ===== Email Service (Optional - Resend) =====
RESEND_API_KEY="YOUR_RESEND_API_KEY"

# ===== Server =====
PORT=3000
NODE_ENV=production
APP_URL="https://yourdomain.com"
